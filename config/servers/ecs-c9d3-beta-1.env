# Settings used on ecs-c9d3-beta-1 (sky47 ECS, 10.10.1.250, EIP <EIP>).
# Deployment log: docs/deployments/ecs-c9d3-beta-1.md   Install: cp this to config/jenkins.env

# ---- Host ----
TIMEZONE=UTC                      # e.g. Asia/Karachi, Asia/Colombo
SWAP_SIZE_GB=4                    # swap is created only if the VM has < 4 GB RAM and no swap yet
ENABLE_UFW=false                  # the sky47 security group is the main firewall; set true to also enable ufw
ADMIN_CIDR=0.0.0.0/0              # used by ufw only: who may reach SSH and the Jenkins UI

# ---- Jenkins ----
JENKINS_PORT=8080
JENKINS_LISTEN_ADDRESS=127.0.0.1         # empty = all interfaces; 127.0.0.1 when nginx (06) fronts Jenkins, so only the proxy can reach it
JENKINS_JAVA_OPTS="-Djava.awt.headless=true -Xms512m -Xmx2g"
JAVA_PACKAGE=openjdk-21-jre       # Jenkins LTS 2.555.1+ needs Java 21 or 25

# ---- Tooling ----
KUBECTL_VERSION=v1.31.0          # empty = latest stable; better: match the CCE cluster, e.g. v1.31.4 (kubectl supports +/-1 minor)
PLUGIN_MANAGER_VERSION=           # empty = latest release of jenkinsci/plugin-installation-manager-tool

# ---- Optional nginx reverse proxy (scripts/06-nginx-reverse-proxy.sh) ----
JENKINS_DOMAIN=jenkins.paykoko.pk # server_name; "_" = any host / bare IP. A real DNS name is required for 08-tls-certbot.sh
CERTBOT_EMAIL=                    # set on the host only (kept out of git); Let's Encrypt expiry notices, used by 08-tls-certbot.sh

# ---- Backups (scripts/backup-jenkins.sh) ----
BACKUP_DIR=/opt/jenkins-backups
BACKUP_KEEP=7
BACKUP_GPG_RECIPIENT=             # public key (id/email) to encrypt archives for; set it before copying backups off the VM
BACKUP_GPG_SIGNER=                # signing key on this VM (id/email); signs archives so restores can verify them
BACKUP_GPG_SIGNER_FPR=            # full fingerprint of that signing key; restore-jenkins.sh rejects archives not signed by it
