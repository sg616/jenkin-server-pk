# Never commit secrets or machine-local config
config/jenkins.env
*.env
!config/jenkins.env.example
# Per-server settings are committed on purpose (no secrets allowed in them)
!config/servers/*.env
secrets/
*.ppk
*.pem
*.key
kubeconfig*
*.kubeconfig
*.tar.gz

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*.stackdump
.remember/
